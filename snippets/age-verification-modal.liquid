{% comment %}
  Renders an age verification gate shown on first visit (persisted via localStorage).
{% endcomment %}

<div id="AgeVerificationModal" class="age-verify-overlay" hidden>
  <div class="age-verify-modal" role="dialog" aria-modal="true" aria-labelledby="AgeVerifyTitle">
    <button type="button" class="age-verify-close" id="AgeVerifyClose" aria-label="{{ 'general.accessibility.close' | t | default: 'Close' }}">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <h2 id="AgeVerifyTitle" class="age-verify-title">연령확인</h2>
    <p class="age-verify-subtitle">(AGE VERIFICATION)</p>

    <div class="age-verify-icon" aria-hidden="true">
      <svg width="90" height="80" viewBox="0 0 90 80" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M45 6L86 74H4L45 6Z" fill="#F7C948" stroke="#1A1A1A" stroke-width="4" stroke-linejoin="round"/>
        <rect x="41.5" y="30" width="7" height="24" rx="3" fill="#1A1A1A"/>
        <circle cx="45" cy="62" r="4" fill="#1A1A1A"/>
      </svg>
    </div>

    <p class="age-verify-question">
      음주 가능한 만19세 이상의 연령입니까?<br>
      Please confirm, are you of legal age of drinking?
    </p>

    <button type="button" class="age-verify-button age-verify-button--yes" id="AgeVerifyYes">
      네, 만19세 이상입니다. (YES)
    </button>
    <button type="button" class="age-verify-button age-verify-button--no" id="AgeVerifyNo">
      아니오 (NO)
    </button>
  </div>
</div>

<style>
  .age-verify-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(20, 16, 14, 0.72);
    backdrop-filter: blur(3px);
    padding: 2rem;
  }

  .age-verify-overlay[hidden] {
    display: none;
  }

  .age-verify-modal {
    position: relative;
    width: 100%;
    max-width: 40rem;
    background: #f3f3f1;
    border-radius: 0.8rem;
    padding: 4rem 3rem 3.5rem;
    text-align: center;
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.35);
  }

  .age-verify-close {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: none;
    background: #fff;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 0.2rem 0.6rem rgba(0, 0, 0, 0.15);
  }

  .age-verify-title {
    font-size: 3.2rem;
    margin: 0 0 0.4rem;
    color: #1a1a1a;
  }

  .age-verify-subtitle {
    font-size: 1.6rem;
    letter-spacing: 0.05rem;
    color: #555;
    margin: 0 0 2rem;
  }

  .age-verify-icon {
    margin: 0 auto 2rem;
    width: 9rem;
  }

  .age-verify-question {
    font-size: 1.7rem;
    line-height: 1.6;
    color: #1a1a1a;
    margin: 0 0 2.6rem;
  }

  .age-verify-button {
    display: block;
    width: 100%;
    max-width: 32rem;
    margin: 0 auto 1.2rem;
    padding: 1.4rem 2rem;
    border-radius: 0.6rem;
    border: none;
    font-size: 1.7rem;
    font-weight: 600;
    color: #fff;
    background: #7b80e0;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .age-verify-button:hover {
    background: #676ccf;
  }

  .age-verify-button--no {
    max-width: 20rem;
    font-weight: 500;
  }

  @media screen and (max-width: 480px) {
    .age-verify-modal {
      padding: 3.5rem 2rem 3rem;
    }

    .age-verify-title {
      font-size: 2.6rem;
    }
  }
</style>

<script>
  (function () {
    var STORAGE_KEY = 'velywein_age_verified';
    var overlay = document.getElementById('AgeVerificationModal');
    if (!overlay) return;

    var isVerified = false;
    try {
      isVerified = window.localStorage.getItem(STORAGE_KEY) === 'true';
    } catch (e) {}

    if (!isVerified) {
      overlay.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    }

    function closeModal() {
      overlay.hidden = true;
      document.documentElement.style.overflow = '';
    }

    document.getElementById('AgeVerifyYes').addEventListener('click', function () {
      try {
        window.localStorage.setItem(STORAGE_KEY, 'true');
      } catch (e) {}
      closeModal();
    });

    document.getElementById('AgeVerifyNo').addEventListener('click', function () {
      window.location.href = 'https://www.google.com';
    });

    document.getElementById('AgeVerifyClose').addEventListener('click', function () {
      closeModal();
    });
  })();
</script>
