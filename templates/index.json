    "philosophy": {
      "type": "rich-text",
      "blocks": {
        "caption_philosophy": {
          "type": "caption",
          "settings": {
            "caption": "BRAND STORY",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading_philosophy": {
          "type": "heading",
          "settings": {
            "heading": "좋은 여운이 좋은 와인입니다",
            "heading_size": "h0"
          }
        },
        "text_philosophy": {
          "type": "text",
          "settings": {
            "text": "<p>Velywein은 벨벳처럼 부드러운 감촉을 뜻하는 Vely와 독일어로 와인을 뜻하는 Wein이 만나 탄생한 이름입니다. 마시는 순간의 화려함보다, 마시고 난 뒤 은은하게 남는 여운이 좋은 와인의 진짜 기준이라 믿습니다.</p>"
          }
        },
        "button_philosophy": {
          "type": "button",
          "settings": {
            "button_label": "브랜드 스토리 보기",
            "button_link": "shopify://pages/about",
            "button_style_secondary": true
          }
        }
      },
      "block_order": [
        "caption_philosophy",
        "heading_philosophy",
        "text_philosophy",
        "button_philosophy"
      ],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-3",
        "full_width": true,
        "padding_top": 72,
        "padding_bottom": 72
      }
